# ─── SEGREDOS — nunca versionar ───────────────────────────────────────────
# Chaves reais da OpenAI e do Gemini. Há um .example ao lado de cada um.
**/config/api_keys.json
**/config/youtube_client.json
**/config/token.json
.env
.env.*

# ─── Dependências e artefatos (reinstaláveis) ─────────────────────────────
node_modules/
.next/
out/
build/
.venv/
venv/
__pycache__/
*.py[cod]
*.tsbuildinfo
.eslintcache

# ─── Binários grandes e baixáveis ─────────────────────────────────────────
# ffmpeg/ffprobe do Windows (189 MB) — o Remotion já traz os seus, e o
# PLANO-ALPHA explica como repor este.
studio/bin/
# Modelo Vosk pt-BR (52 MB) — baixe de alphacephei.com/vosk/models
voice/models/

# ─── Mídia: pesada e só necessária na máquina que renderiza ───────────────
# A regra do projeto: TEXTO sincroniza, MÍDIA não. Ver docs/GIT-E-SINCRONIA.md
public/videos/
public/audio/
public/music/
renders/
*.mp4
*.mov
*.webm
*.mp3
*.wav
*.m4a
# ...exceto a cara do Alpha, que é do código.
!voice/face.png

# ─── Sistema ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# Imagens geradas pela OpenAI — artefato reproduzível, não código.
voice/imagens/

# Perfil do navegador do OMEGA — contem SESSOES DE LOGIN. Nunca versionar.
voice/navegador-perfil/
voice/nao-entendidas.txt

# Áudio de teste da escuta: gerado (_audio_teste) ou gravado pelo Samuel
# (gravacoes). Nenhum dos dois é código, e a voz dele não vai para o GitHub.
voice/_audio_teste/
voice/gravacoes/
# O diario de falas contem o que o Samuel DIZ -- fica na maquina dele.
# Ja o vocabulario aprendido sao so pares de palavras, e vale versionar:
# assim o que ele ensina num PC vale no outro.
voice/aprendizado.jsonl

# Prints do navegador: mostram a tela LOGADA do Samuel.
voice/_prints/

# Maratona do curso: estado de execucao e o LINK do curso comprado dele.
voice/_maratona.json
voice/_maratona.parar
voice/_falando.flag
voice/config/curso.json

# Log de execução do app: contém a CONVERSA do Samuel (o OMEGA_LOG ecoa tudo).
voice/_app.log
voice/_app.err
voice/_audio_fp/
